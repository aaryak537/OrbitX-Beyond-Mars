<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08121F">

    <!-- Stars Background -->
    <ImageView
        android:id="@+id/imgStars"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/space_background"
        android:src="@drawable/bg_space" />

    <!-- Rocket -->
    <ImageView
        android:id="@+id/imgRocket"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="70dp"
        android:src="@drawable/ic_rocket"
        android:contentDescription="@string/rocket" />

    <!-- Loading Text -->
    <TextView
        android:id="@+id/txtLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/imgRocket"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="25dp"
        android:text="@string/preparing_mission"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"/>

    <!-- Progress Percentage -->
    <TextView
        android:id="@+id/txtPercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/txtLoading"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="18dp"
        android:text="0%"
        android:textColor="#FFC857"
        android:textSize="28sp"
        android:textStyle="bold"/>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/loadingBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="420dp"
        android:layout_height="14dp"
        android:layout_below="@id/txtPercent"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#FF6B35"
        android:progressBackgroundTint="#2A3D4F"/>

    <!-- Tip Card -->
    <LinearLayout
        android:id="@+id/tipCard"
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="50dp"
        android:background="@drawable/bg_tip_card"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mission_tip"
            android:textColor="#FFC857"
            android:textStyle="bold"
            android:textSize="18sp"/>

        <TextView
            android:id="@+id/txtTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Upgrade miners to earn faster."
            android:textColor="#FFFFFF"
            android:textSize="16sp"/>

    </LinearLayout>

</RelativeLayout>