<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/landingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050817">

    <!-- SPACE BACKGROUND -->
    <ImageView
        android:id="@+id/imgSpace"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_space" />

    <!-- DARK CINEMATIC OVERLAY -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#35000000" />

    <!-- MARS HORIZON -->
    <ImageView
        android:id="@+id/imgMarsGround"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:layout_gravity="bottom"
        android:scaleType="centerCrop"
        android:src="@drawable/mars_ground" />

    <!-- LANDING PAD -->
    <ImageView
        android:id="@+id/imgLandingPad"
        android:layout_width="180dp"
        android:layout_height="70dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="105dp"
        android:scaleType="fitCenter"
        android:src="@drawable/landing_pad"
        android:alpha="0.95" />

    <!-- ROCKET -->
    <ImageView
        android:id="@+id/imgRocket"
        android:layout_width="105dp"
        android:layout_height="210dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="-230dp"
        android:scaleType="fitCenter"
        android:src="@drawable/rocket"
        android:elevation="10dp" />

    <!-- ROCKET ENGINE GLOW -->
    <View
        android:id="@+id/engineGlow"
        android:layout_width="38dp"
        android:layout_height="95dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="120dp"
        android:background="@drawable/engine_glow"
        android:alpha="0.9" />

    <!-- DUST EFFECT -->
    <ImageView
        android:id="@+id/imgDust"
        android:layout_width="240dp"
        android:layout_height="100dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="95dp"
        android:scaleType="fitCenter"
        android:src="@drawable/dust"
        android:alpha="0" />

    <!-- ASTRONAUT -->
    <ImageView
        android:id="@+id/imgAstronaut"
        android:layout_width="105dp"
        android:layout_height="190dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="65dp"
        android:layout_marginBottom="105dp"
        android:scaleType="fitCenter"
        android:src="@drawable/astronaut"
        android:alpha="0" />

    <!-- TOP CINEMATIC TEXT -->
    <LinearLayout
        android:id="@+id/titleContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="55dp"
        android:gravity="center"
        android:orientation="vertical"
        android:alpha="0">

        <TextView
            android:id="@+id/txtMissionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MISSION 01"
            android:textColor="#FF6B35"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.18" />

        <TextView
            android:id="@+id/txtLandingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="LANDING ON MARS"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

    </LinearLayout>

    <!-- LANDING STATUS -->
    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="38dp"
        android:text="INITIALIZING LANDING..."
        android:textColor="#BFEFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:alpha="0.9" />


    <!-- SKIP -->
    <TextView
        android:id="@+id/btnSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="22dp"
        android:text="SKIP  ›"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:alpha="0.75"
        android:padding="10dp" />

</FrameLayout>