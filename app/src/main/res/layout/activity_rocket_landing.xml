<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background -->

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/space_background"
        android:src="@drawable/bg_space"/>

    <!-- Mars Surface -->

    <ImageView
        android:id="@+id/marsSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/mars"
        android:src="@drawable/mars"/>

    <!-- Dust -->

    <ImageView
        android:id="@+id/dust"
        android:layout_width="300dp"
        android:layout_height="180dp"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="100dp"
        android:contentDescription="@string/smoke"
        android:src="@drawable/dust"
        android:alpha="0"/>

    <!-- Rocket -->

    <ImageView
        android:id="@+id/rocket"
        android:layout_width="130dp"
        android:layout_height="220dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="-250dp"
        android:contentDescription="@string/rocket"
        android:src="@drawable/rocket"/>

    <!-- Astronaut -->

    <ImageView
        android:id="@+id/astronaut"
        android:layout_width="70dp"
        android:layout_height="110dp"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="180dp"
        android:contentDescription="@string/astronaut"
        android:src="@drawable/astronaut"
        android:alpha="0"/>

</FrameLayout>