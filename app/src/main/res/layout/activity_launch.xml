<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050A18">

    <!-- ================= BACKGROUND ================= -->

    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_space"
        android:contentDescription="@string/space_background"/>

    <!-- ================= ORBITX LOGO ================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardOrbitX"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_alignParentStart="true"
        android:layout_marginStart="24dp"
        android:layout_marginTop="10dp"

        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="45dp"
        app:cardElevation="10dp"
        app:strokeColor="#FFC857"
        app:strokeWidth="3dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:src="@drawable/orbitx_logo" />

    </com.google.android.material.card.MaterialCardView>

    <!-- ================= GAME LOGO ================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardGameLogo"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"

        android:background="@drawable/logo_glow"

        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="55dp"
        app:cardElevation="12dp"
        app:strokeColor="#FFC857"
        app:strokeWidth="3dp">

        <ImageView
            android:id="@+id/imgGameLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:src="@drawable/beyond_mars_logo" />

    </com.google.android.material.card.MaterialCardView>

    <!-- ================= ROCKET ================= -->

    <ImageView
        android:id="@+id/imgRocket"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_below="@id/cardGameLogo"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:src="@drawable/ic_rocket"
        app:tint="#FFC857"
        android:contentDescription="@string/rocket"/>

    <!-- ================= LOADING ================= -->

    <ImageView
        android:id="@+id/imgMars"
        android:layout_width="430dp"
        android:layout_height="430dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="-90dp"
        android:layout_marginBottom="-90dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/mars_background"
        android:src="@drawable/mars" />

    <TextView
        android:id="@+id/txtLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/imgRocket"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:text="Preparing Mission..."
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="22sp"/>

    <!-- ================= PERCENT ================= -->

    <TextView
        android:id="@+id/txtPercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/txtLoading"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:text="0%"
        android:textColor="#FFC857"
        android:textStyle="bold"
        android:textSize="28sp"/>

    <!-- ================= PROGRESS BAR ================= -->

    <ProgressBar
        android:id="@+id/loadingBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="360dp"
        android:layout_height="14dp"
        android:layout_below="@id/txtPercent"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#FF6B35"
        android:progressBackgroundTint="#2A3D4F"/>

