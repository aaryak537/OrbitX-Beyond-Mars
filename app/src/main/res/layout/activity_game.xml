<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gameRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ===================================================== -->
    <!-- MARS BACKGROUND                                       -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/mars_background"
        android:src="@drawable/bg_mars" />

    <!-- Stars / Night overlay -->
    <ImageView
        android:id="@+id/imgStars"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:scaleType="centerCrop"
        android:contentDescription="@string/stars"
        android:src="@drawable/stars_overlay" />

    <!-- ===================================================== -->
    <!-- TOP HUD                                                -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/topHUD"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@drawable/bg_panel"
        android:elevation="8dp"
        android:weightSum="4">

        <!-- COINS -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/energy_coins"
                android:src="@drawable/ic_coin"
                app:tint="#FFD54F" />

            <TextView
                android:id="@+id/txtCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- MINERALS -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/minerals_gems"
                android:src="@drawable/ic_gem"
                app:tint="#FF8A3D" />

            <TextView
                android:id="@+id/txtMinerals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="0"
                android:textColor="#FFB36B"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ENERGY -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/energy_coins"
                android:src="@drawable/ic_energy"
                app:tint="#00FF99" />

            <TextView
                android:id="@+id/txtEnergy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="0"
                android:textColor="#00FF99"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- LEVEL -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/levels"
                android:src="@drawable/ic_level" />

            <TextView
                android:id="@+id/txtLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="Lv.1"
                android:textColor="#FFD54F"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- MISSION PANEL                                          -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/missionPanel"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/topHUD"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/bg_panel"
        android:elevation="6dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mission"
            android:textColor="#FFD54F"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtMission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="2"
            android:text="Collect Minerals"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressMission"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/txtMissionProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0 / 100"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- MARS MOUNTAINS                                         -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/imgMountains"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="88dp"
        android:contentDescription="@string/mars_background"
        android:scaleType="fitXY"
        android:src="@drawable/mars_mountains" />


    <!-- ===================================================== -->
    <!-- MARS GROUND                                            -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/imgGround"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="70dp"
        android:contentDescription="@string/mars_background"
        android:scaleType="fitXY"
        android:src="@drawable/mars_ground" />


    <!-- ===================================================== -->
    <!-- WORKER / MINERAL INFO                                  -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/colonyInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/missionPanel"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@drawable/bg_panel"
        android:elevation="4dp">

        <TextView
            android:id="@+id/txtWorkers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Workers : 0"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtMineralRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="⛏ +0 Minerals/sec"
            android:textColor="#FFB36B"
            android:textSize="12sp" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- BUILDINGS LAYER                                        -->
    <!-- ===================================================== -->

    <FrameLayout
        android:id="@+id/buildingLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- HEADQUARTERS -->

        <ImageView
            android:id="@+id/imgHQ"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="145dp"
            android:contentDescription="@string/base"
            android:src="@drawable/base_hq" />

        <!-- SOLAR -->

        <ImageView
            android:id="@+id/imgSolar"
            android:layout_width="95dp"
            android:layout_height="95dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="170dp"
            android:layout_marginBottom="155dp"
            android:visibility="gone"
            android:contentDescription="@string/building_solar_panel"
            android:src="@drawable/building_solar" />

        <!-- MINE -->

        <ImageView
            android:id="@+id/imgMine"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="170dp"
            android:layout_marginBottom="145dp"
            android:visibility="gone"
            android:contentDescription="@string/building_mine"
            android:src="@drawable/building_mine" />

        <!-- GREENHOUSE -->

        <ImageView
            android:id="@+id/imgGreenhouse"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="55dp"
            android:layout_marginBottom="140dp"
            android:visibility="gone"
            android:contentDescription="@string/building_greenhouse"
            android:src="@drawable/building_greenhouse" />

        <!-- OXYGEN PLANT -->

        <ImageView
            android:id="@+id/imgOxygen"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="55dp"
            android:layout_marginBottom="140dp"
            android:visibility="gone"
            android:contentDescription="Oxygen Plant"
            android:src="@drawable/building_oxygen" />

    </FrameLayout>


    <!-- ===================================================== -->
    <!-- ASTRONAUT — MAIN INTERACTION                           -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/imgAstronaut"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_above="@id/imgGround"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="40dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/astronaut"
        android:src="@drawable/astronaut"
        android:elevation="12dp" />


    <!-- ===================================================== -->
    <!-- FLOATING RESOURCE CONTAINER                            -->
    <!-- ===================================================== -->

    <FrameLayout
        android:id="@+id/floatingResourceContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />


    <!-- ===================================================== -->
    <!-- PARTICLE CONTAINER                                     -->
    <!-- ===================================================== -->

    <FrameLayout
        android:id="@+id/particleContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />


    <!-- ===================================================== -->
    <!-- CONSTRUCTION PANEL                                     -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/constructionPanel"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_above="@id/imgGround"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_panel"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/constructing"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/energyBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- FLOATING REWARD                                       -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/txtFloatingReward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="+5 Minerals"
        android:textColor="#FFD700"
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:elevation="20dp" />


    <!-- ===================================================== -->
    <!-- FLOATING XP                                            -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/txtFloatingXP"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_above="@id/txtFloatingReward"
        android:text="+1 XP"
        android:textColor="#00E5FF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:elevation="20dp" />


    <!-- ===================================================== -->
    <!-- BOTTOM MENU                                            -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/bottomMenu"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_alignParentBottom="true"
        android:background="#E6111111"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:weightSum="5"
        android:elevation="20dp">

        <!-- SHOP -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnShop"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/shop"
                android:scaleType="centerInside"
                android:src="@drawable/ic_shop"
                app:tint="#03A9F4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shop"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

        </LinearLayout>


        <!-- BUILD -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnBuild"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/build"
                android:scaleType="centerInside"
                android:src="@drawable/ic_build"
                app:tint="#4CAF50" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/build"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

        </LinearLayout>


        <!-- WORKERS -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnWorkers"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/workers"
                android:scaleType="centerInside"
                android:src="@drawable/ic_worker" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/workers"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

        </LinearLayout>


        <!-- ROCKET -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnRocket"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/rocket"
                android:scaleType="centerInside"
                android:src="@drawable/ic_rocket"
                app:tint="#9C27B0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rocket"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

        </LinearLayout>


        <!-- SETTINGS -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/setting"
                android:scaleType="centerInside"
                android:src="@drawable/ic_settings"
                app:tint="#FFD54F" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- PAUSE OVERLAY                                          -->
    <!-- ===================================================== -->

    <FrameLayout
        android:id="@+id/pauseOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone"
        android:elevation="100dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/game_paused"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

    </FrameLayout>

</RelativeLayout>