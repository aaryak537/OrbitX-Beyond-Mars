<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gameRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ========================= -->
    <!-- MARS BACKGROUND -->
    <!-- ========================= -->

    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_mars"/>

    <!-- ========================= -->
    <!-- STARS -->
    <!-- ========================= -->

    <ImageView
        android:id="@+id/imgStars"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:scaleType="centerCrop"
        android:src="@drawable/stars_overlay"/>

    <!-- ========================= -->
    <!-- SUN -->
    <!-- ========================= -->

    <ImageView
        android:id="@+id/imgSun"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_margin="20dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:src="@drawable/ic_sun"/>

    <!-- ========================= -->
    <!-- MOON -->
    <!-- ========================= -->

    <ImageView
        android:id="@+id/imgMoon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_margin="20dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:alpha="0"
        android:src="@drawable/ic_moon"/>

    <!-- ========================= -->
    <!-- DAY NIGHT OVERLAY -->
    <!-- ========================= -->

    <View
        android:id="@+id/dayNightOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#001B3A"/>

    <!-- ========================= -->
    <!-- TOP HUD -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/topHUD"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:weightSum="4">

        <!-- Coins -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_coin"/>

            <TextView
                android:id="@+id/txtCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"/>

        </LinearLayout>

        <!-- Gems -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_gem"/>

            <TextView
                android:id="@+id/txtGems"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"/>

        </LinearLayout>

        <!-- Energy -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_energy"/>

            <TextView
                android:id="@+id/txtEnergy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100"
                android:textColor="#00FF99"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"/>

        </LinearLayout>

        <!-- Level -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_level"/>

            <TextView
                android:id="@+id/txtLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lv.1"
                android:textColor="#FFD54F"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- ========================= -->
    <!-- MISSION PANEL -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/missionPanel"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/topHUD"
        android:layout_marginStart="12dp"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/bg_panel">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MISSION"
            android:textStyle="bold"
            android:textColor="#FFD54F"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/txtMission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Collect 100 Minerals"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:layout_marginTop="5dp"/>

        <ProgressBar
            android:id="@+id/progressMission"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:max="100"
            android:progress="15"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/txtMissionProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15 / 100"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

    <ImageView
        android:id="@+id/imgMountains"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="90dp"
        android:scaleType="fitXY"
        android:src="@drawable/mars_mountains" />

    <ImageView
        android:id="@+id/imgGround"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="70dp"
        android:scaleType="fitXY"
        android:src="@drawable/mars_ground" />

    <!-- ===================================================== -->
    <!-- BUILDINGS LAYER -->
    <!-- ===================================================== -->

    <FrameLayout
        android:id="@+id/buildingLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Headquarters -->

        <ImageView
            android:id="@+id/imgHQ"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="145dp"
            android:src="@drawable/base_hq" />

        <!-- Solar Panel -->

        <ImageView
            android:id="@+id/imgSolar"
            android:layout_width="95dp"
            android:layout_height="95dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="170dp"
            android:layout_marginBottom="155dp"
            android:visibility="gone"
            android:src="@drawable/building_solar" />

        <!-- Mine -->

        <ImageView
            android:id="@+id/imgMine"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="170dp"
            android:layout_marginBottom="145dp"
            android:visibility="gone"
            android:src="@drawable/building_mine" />

        <!-- Greenhouse -->

        <ImageView
            android:id="@+id/imgGreenhouse"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="55dp"
            android:layout_marginBottom="140dp"
            android:visibility="gone"
            android:src="@drawable/building_greenhouse" />

        <!-- Oxygen Plant

        <ImageView
            android:id="@+id/imgOxygen"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="55dp"
            android:layout_marginBottom="140dp"
            android:visibility="gone"
            android:src="@drawable/building_oxygen" />
-->
    </FrameLayout>

    <!-- ===================================================== -->
    <!-- ASTRONAUT -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/imgAstronaut"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_above="@id/imgGround"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="45dp"
        android:src="@drawable/astronaut" />

    <!-- ===================================================== -->
    <!-- FLOATING RESOURCE CONTAINER -->
    <!-- ===================================================== -->

    <FrameLayout
        android:id="@+id/floatingResourceContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!-- ===================================================== -->
    <!-- TAP EFFECT CONTAINER -->
    <!-- ===================================================== -->

    <FrameLayout
        android:id="@+id/particleContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!-- ===================================================== -->
    <!-- CONSTRUCTION PROGRESS PANEL -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/constructionPanel"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_above="@id/imgGround"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_panel"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Building..."
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/buildProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="40" />

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- RESOURCE GAIN TEXT -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/txtFloatingCoins"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="+10"
        android:textColor="#FFD700"
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- ===================================================== -->
    <!-- XP GAIN -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/txtFloatingXP"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_above="@id/txtFloatingCoins"
        android:text="+5 XP"
        android:textColor="#00E5FF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- ===================================================== -->
    <!-- BOTTOM MENU -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/bottomMenu"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_alignParentBottom="true"
        android:background="#CC111111"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:weightSum="5">

        <!-- SHOP -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnShop"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:src="@drawable/ic_shop"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shop"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- BUILD -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnBuild"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_build"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Build"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- WORKERS -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnWorkers"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_worker"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Workers"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- ROCKET -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnRocket"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_rocket"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rocket"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- SETTINGS -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_settings"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- BUILDING PLACEHOLDERS -->
    <!-- ===================================================== -->

    <View
        android:id="@+id/placeholderLeft"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_above="@id/bottomMenu"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="15dp"
        android:background="#22FFFFFF"
        android:visibility="gone"/>

    <View
        android:id="@+id/placeholderRight"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_above="@id/bottomMenu"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="15dp"
        android:background="#22FFFFFF"
        android:visibility="gone"/>

    <!-- ===================================================== -->
    <!-- PAUSE OVERLAY -->
    <!-- ===================================================== -->

    <FrameLayout
        android:id="@+id/pauseOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="GAME PAUSED"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"/>

    </FrameLayout>

</RelativeLayout>