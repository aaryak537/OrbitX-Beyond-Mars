<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gameRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_space"
    android:keepScreenOn="true"
    tools:context=".GameActivity">

    <!--============================-->
    <!-- Background Stars Overlay -->
    <!--============================-->

    <ImageView
        android:id="@+id/imgStars"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.35"
        android:scaleType="centerCrop"
        android:src="@drawable/stars_overlay"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!--============================-->
    <!-- Clouds / Fog Layer -->
    <!--============================-->

    <ImageView
        android:id="@+id/imgClouds"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.18"
        android:scaleType="centerCrop"
        android:src="@drawable/cloud_overlay"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!--============================-->
    <!-- Top HUD Container -->
    <!--============================-->

    <androidx.cardview.widget.CardView
        android:id="@+id/topHudCard"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="18dp"
        app:cardBackgroundColor="#6613203B"
        app:cardElevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <!-- Coins -->

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                app:tint="#FFD54F"
                android:src="@drawable/ic_coin"/>

            <TextView
                android:id="@+id/txtCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="1200"
                android:textColor="#FFD54F"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <Space
                android:layout_width="40dp"
                android:layout_height="1dp"/>

            <!-- Gems -->

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                app:tint="#55E6FF"
                android:src="@drawable/ic_gem"/>

            <TextView
                android:id="@+id/txtGems"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="25"
                android:textColor="#55E6FF"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <!-- Pause -->

            <ImageButton
                android:id="@+id/btnPause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_pause"
                app:tint="@android:color/white"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!--============================-->
    <!-- Energy Section -->
    <!--============================-->

    <LinearLayout
        android:id="@+id/energyLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/topHudCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:tint="@android:color/white"
            android:src="@drawable/ic_energy"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Energy"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp"/>

        <ProgressBar
            android:id="@+id/progressEnergy"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="82"
            android:progressDrawable="@drawable/progress_energy"/>

        <TextView
            android:id="@+id/txtEnergy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="82%"
            android:textColor="#7CFF8A"
            android:textSize="15sp"
            android:textStyle="bold"/>

    </LinearLayout>
    <!--================================================-->
    <!--                 MARS GAME AREA                 -->
    <!--================================================-->

    <FrameLayout
        android:id="@+id/marsContainer"
        android:layout_width="340dp"
        android:layout_height="340dp"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/energyLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Glow Behind Mars -->

        <ImageView
            android:id="@+id/imgMarsGlow"
            android:layout_width="290dp"
            android:layout_height="290dp"
            android:layout_gravity="center"
            android:alpha="0.75"
            android:scaleType="fitCenter"
            android:src="@drawable/glow_circle"/>

        <!-- Outer Ring -->

        <ImageView
            android:id="@+id/imgOrbitRing"
            android:layout_width="310dp"
            android:layout_height="310dp"
            android:layout_gravity="center"
            android:alpha="0.55"
            android:src="@drawable/orbit_ring"/>

        <!-- Clickable Mars -->

        <ImageButton
            android:id="@+id/btnMars"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:background="@android:color/transparent"
            android:contentDescription="Mars"
            android:scaleType="fitCenter"
            android:src="@drawable/mars"/>

        <!-- Tap Text -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtPlanet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BEYOND MARS"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtTap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tap Mars"
                android:textColor="#FFC857"
                android:textSize="16sp"/>

        </LinearLayout>

        <!-- Floating Reward LEFT -->

        <TextView
            android:id="@+id/rewardLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="18dp"
            android:text="+2"
            android:textColor="#7CFF7C"
            android:textSize="24sp"
            android:textStyle="bold"
            android:visibility="gone"/>

        <!-- Floating Reward RIGHT -->

        <TextView
            android:id="@+id/rewardRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="18dp"
            android:text="+5"
            android:textColor="#55E6FF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:visibility="gone"/>

        <!-- Floating Reward TOP -->

        <TextView
            android:id="@+id/rewardTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="20dp"
            android:text="+3"
            android:textColor="#FFD54F"
            android:textSize="26sp"
            android:textStyle="bold"
            android:visibility="gone"/>

        <!-- Spark Effect Overlay -->

        <ImageView
            android:id="@+id/imgSpark"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:src="@drawable/spark_effect"/>

    </FrameLayout>
    <!--================================================-->
    <!--              PLAYER STATS SECTION              -->
    <!--================================================-->

    <LinearLayout
        android:id="@+id/statsLayout"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintTop_toBottomOf="@id/marsContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!--====================-->
        <!-- AUTO INCOME CARD -->
        <!--====================-->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardIncome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="6dp"
            app:cardBackgroundColor="#AA142742"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_income"
                    app:tint="#FFC857"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Auto Income"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtIncome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="+18/sec"
                    android:textColor="#7CFF8A"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!--====================-->
        <!-- WORKERS CARD -->
        <!--====================-->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardWorkers"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="6dp"
            app:cardBackgroundColor="#AA142742"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_worker"
                    app:tint="#55E6FF"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Workers"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtWorkers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="12"
                    android:textColor="#55E6FF"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!--====================-->
        <!-- LEVEL CARD -->
        <!--====================-->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardLevel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="6dp"
            app:cardBackgroundColor="#AA142742"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_level"
                    app:tint="#FFB347"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Level"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Lv. 7"
                    android:textColor="#FFC857"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>
    <!--================================================-->
    <!--            PREMIUM BOTTOM NAVIGATION           -->
    <!--================================================-->

    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavigationCard"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#CC13233B"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:weightSum="5">

            <!--================ SHOP ================-->

            <LinearLayout
                android:id="@+id/navShop"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_shop"
                    app:tint="#FFC857"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Shop"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!--============== UPGRADE ==============-->

            <LinearLayout
                android:id="@+id/navUpgrade"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_upgrade"
                    app:tint="#55E6FF"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Upgrade"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!--============== ROCKET ==============-->

            <LinearLayout
                android:id="@+id/navRocket"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_rocket"
                    app:tint="#FF7A1A"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Rocket"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!--============== MISSION ==============-->

            <LinearLayout
                android:id="@+id/navMission"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_mission"
                    app:tint="#7CFF8A"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Mission"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!--=============== STATS ===============-->

            <LinearLayout
                android:id="@+id/navStats"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_stats"
                    app:tint="#B388FF"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Stats"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>